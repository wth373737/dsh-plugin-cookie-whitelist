{
  "manifest_version": 3,
  "name": "DSH Cookie Whitelist Bridge",
  "version": "1.0.0",
  "description": "Send cookies for approved domains from this browser to the local DSH Cookie Whitelist plugin. Local 127.0.0.1 only; no telemetry.",
  "minimum_chrome_version": "116",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "DSH Cookie Whitelist",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
