{
  "manifest_version": 2,
  "name": "DSH Cookie Whitelist Bridge",
  "version": "1.0.0",
  "description": "Send cookies for approved domains from this browser to the local DSH Cookie Whitelist plugin. Local 127.0.0.1 only; no telemetry.",
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_action": {
    "default_title": "DSH Cookie Whitelist",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cookie-whitelist@wth373737",
      "strict_min_version": "115.0"
    }
  }
}
